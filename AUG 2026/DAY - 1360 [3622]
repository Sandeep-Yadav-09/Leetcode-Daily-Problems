** 3622. Check Divisibility by Digit Sum and Product **

# Approach 1:
class Solution:
    def checkDivisibility(self, n: int) -> bool:
        original = n
        total_sum = 0
        product = 1

        while n != 0:

            digit = n % 10

            total_sum += digit
            product *= digit

            n //= 10

        return original % (total_sum + product) == 0

# Approach 2:
class Solution:
    def checkDivisibility(self, n: int) -> bool:
        result = [int(digit) for digit in str(n)]

        sum_n = 0
        prod_n = 1

        for i in range(len(result)):
            sum_n += result[i]
            prod_n *= result[i]

        if (sum_n + prod_n) == 0:
            return False

        if n % (sum_n + prod_n) == 0:
            return True
        else:
            return False
