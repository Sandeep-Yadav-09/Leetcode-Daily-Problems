** 3069. Distribute Elements Into Two Arrays I **

# Approach 1:
class Solution:
    def resultArray(self, nums: List[int]) -> List[int]:
        nums1 = [nums[0]]
        nums2 = [nums[1]]

        for i in range(2, len(nums)):
            if nums1[-1] > nums2[-1]:
                nums1.append(nums[i])
            else:
                nums2.append(nums[i])

        return nums1 + nums2
        
# Approach 2:
class Solution:
    def resultArray(self, nums: List[int]) -> List[int]:
        arr1 = []
        arr2 = []
        arr1.append(nums[0])
        arr2.append(nums[1])

        for i in range(2, len(nums)):
            if arr1[-1]>arr2[-1]:
                arr1.append(nums[i])
            else:
                arr2.append(nums[i])

        for i in range(len(arr2)):
            arr1.append(arr2[i])

        return arr1
