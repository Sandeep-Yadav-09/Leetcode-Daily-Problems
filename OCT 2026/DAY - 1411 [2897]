** 2897. Apply Operations on Array to Maximize Sum of Squares **

# Approach 1:
class Solution:
    def maxSum(self, nums: List[int], k: int) -> int:
        MOD = 10**9 + 7
        cnt = [0] * 30

        for x in nums:
            for b in range(30):
                if x >> b & 1:
                    cnt[b] += 1

        ans = 0
        for _ in range(k):
            x = 0
            for b in range(30):
                if cnt[b]:
                    x |= 1 << b
                    cnt[b] -= 1
            ans = (ans + x * x) % MOD

        return ans

# Approach 2:
from typing import List

class Solution:
    def maxSum(self, nums: List[int], k: int) -> int:
        MOD = 10**9 + 7
        bit_counts = [0] * 30

        for num in nums:
            for b in range(30):
                if (num >> b) & 1:
                    bit_counts[b] += 1
                    
        ans = 0

        for _ in range(k):
            curr = 0
            for b in range(30):
                if bit_counts[b] > 0:
                    curr |= (1 << b)
                    bit_counts[b] -= 1

            if curr == 0:
                break
                
            ans = (ans + curr * curr) % MOD
            
        return ans
