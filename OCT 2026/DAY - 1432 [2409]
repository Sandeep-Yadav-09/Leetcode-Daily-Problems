** 2409. Count Days Spent Together **

# Approach 1:
class Solution:
    def countDaysTogether(self, arriveAlice: str, leaveAlice: str,
                          arriveBob: str, leaveBob: str) -> int:
        start = max(arriveAlice, arriveBob)
        end = min(leaveAlice, leaveBob)

        if start > end:
            return 0

        days = [31, 28, 31, 30, 31, 30,
                31, 31, 30, 31, 30, 31]

        def to_days(date):
            month, day = map(int, date.split('-'))
            return sum(days[:month - 1]) + day

        return to_days(end) - to_days(start) + 1

# Approach 2:
class Solution:
    def countDaysTogether(
        self, arriveAlice: str, leaveAlice: str, arriveBob: str, leaveBob: str
    ) -> int:
        def date_key(date: str) -> int:
            return int(date[:2]) * 100 + int(date[3:])

        a_start = date_key(arriveAlice)
        a_end = date_key(leaveAlice)
        b_start = date_key(arriveBob)
        b_end = date_key(leaveBob)

        days_in_month = [31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]

        answer = 0

        for month, length in enumerate(days_in_month, start=1):
            for day in range(1, length + 1):
                current = month * 100 + day

                if a_start <= current <= a_end and b_start <= current <= b_end:
                    answer += 1

        return answer
