** 1541. Minimum Insertions to Balance a Parentheses String **

# Approach 1:
class Solution:
    def minInsertions(self, s: str) -> int:
        s2 = s.replace('))', '#')
        need = 0
        missing = 0
        for c in s2:
            if c == '(':
                need += 2
            else:
                if c == ')':
                    missing += 1
                    if need == 0:
                        missing += 1
                    else:
                        need -= 2
                elif c == '#':
                    if need == 0:
                        missing += 1
                    else:
                        need -= 2

        return need + missing

# Approach 2:
class Solution:
    def minInsertions(self, s: str) -> int:
        st = []
        res = 0
        i = 0

        while i < len(s):
            ch = s[i]

            if ch == '(':
                st.append(ch)
            else:
                if not st:
                    if i < len(s) - 1 and s[i + 1] == ')':
                        i += 1
                    else:
                        res += 1
                    res += 1
                else:
                    if i < len(s) - 1 and s[i + 1] == ')':
                        i += 1
                    else:
                        res += 1
                    st.pop()

            i += 1

        return res + len(st) * 2
