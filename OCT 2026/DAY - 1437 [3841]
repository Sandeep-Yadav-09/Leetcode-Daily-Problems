** 3841. Palindromic Path Queries in a Tree **

# Approach 1:
class Solution:
    def palindromePath(self, n: int, edges: list[list[int]], s: str, queries: list[str]) -> list[bool]:

        graph = [[] for _ in range(n)]
        for u, v in edges:
            graph[u].append(v)
            graph[v].append(u)

        LOG = 17  
        parent = [[-1] * n for _ in range(LOG)]
        depth = [0] * n
        tin = [0] * n
        tout = [0] * n
        timer = 0

        def dfs(node: int, par: int):
            nonlocal timer
            tin[node] = timer
            timer += 1
            parent[0][node] = par

            for nei in graph[node]:
                if nei == par:
                    continue
                depth[nei] = depth[node] + 1
                dfs(nei, node)

            tout[node] = timer - 1

        dfs(0, -1)

        for k in range(1, LOG):
            for i in range(n):
                p = parent[k - 1][i]
                if p != -1:
                    parent[k][i] = parent[k - 1][p]

        def lca(u: int, v: int) -> int:
            if depth[u] < depth[v]:
                u, v = v, u

            diff = depth[u] - depth[v]
            for k in range(LOG):
                if diff & (1 << k):
                    u = parent[k][u]

            if u == v:
                return u

            for k in reversed(range(LOG)):
                if parent[k][u] != parent[k][v]:
                    u = parent[k][u]
                    v = parent[k][v]

            return parent[0][u]

        size = n
        fenwick = [0] * (n + 1)

        def fenwick_add(i: int, val: int):
            i += 1
            while i <= size:
                fenwick[i] ^= val
                i += i & -i

        def fenwick_prefix(i: int) -> int:
            res = 0
            i += 1
            while i > 0:
                res ^= fenwick[i]
                i -= i & -i
            return res

        def char_mask(c: str) -> int:
            return 1 << (ord(c) - ord('a'))

        labels = list(s)

        for u, c in enumerate(labels):
            m = char_mask(c)
            fenwick_add(tin[u], m)
            fenwick_add(tout[u] + 1, m)

        answers = []

        for q in queries:
            parts = q.split()

            if parts[0] == "update":
                u = int(parts[1])
                new_char = parts[2]

                delta = char_mask(labels[u]) ^ char_mask(new_char)
                labels[u] = new_char

                fenwick_add(tin[u], delta)
                fenwick_add(tout[u] + 1, delta)

            else: 
                u, v = int(parts[1]), int(parts[2])
                w = lca(u, v)

                path_mask = (
                    fenwick_prefix(tin[u])
                    ^ fenwick_prefix(tin[v])
                    ^ char_mask(labels[w])
                )

                answers.append(
                    path_mask == 0 or (path_mask & (path_mask - 1)) == 0
                )

        return answers

# Approach 2:
import sys

class Solution:
    def palindromePath(self, n: int, edges: list[list[int]], s: str, queries: list[str]) -> list[bool]:
        # Build the adjacency list
        adj = [[] for _ in range(n)]
        for u, v in edges:
            adj[u].append(v)
            adj[v].append(u)
            
        # Iterative DFS to compute entry/exit times, depth, and binary lifting table
        tin = [0] * n
        tout = [0] * n
        depth = [0] * n
        LOGN = 16  # 2^16 > 50000
        up = [[0] * LOGN for _ in range(n)]
        
        timer = 1
        iters = [iter(adj[u]) for u in range(n)]
        stack = [0]
        tin[0] = timer
        timer += 1
        depth[0] = 0
        
        while stack:
            u = stack[-1]
            try:
                v = next(iters[u])
                if v != up[u][0]:  # Avoid going back to parent
                    up[v][0] = u
                    depth[v] = depth[u] + 1
                    tin[v] = timer
                    timer += 1
                    stack.append(v)
            except StopIteration:
                tout[u] = timer - 1
                stack.pop()
                
        # Initialize binary lifting table for LCA
        for j in range(1, LOGN):
            for i in range(n):
                up[i][j] = up[up[i][j - 1]][j - 1]
                
        # Helper function to find LCA
        def get_lca(u, v):
            if depth[u] < depth[v]:
                u, v = v, u
            diff = depth[u] - depth[v]
            for j in range(LOGN):
                if (diff >> j) & 1:
                    u = up[u][j]
            if u == v:
                return u
            for j in range(LOGN - 1, -1, -1):
                if up[u][j] != up[v][j]:
                    u = up[u][j]
                    v = up[v][j]
            return up[u][0]
            
        # Fenwick Tree (Binary Indexed Tree) for range updates and point queries
        tree_size = n + 5
        tree = [0] * tree_size
        
        def range_update(l, r, val):
            # Add to position l
            idx = l
            while idx < tree_size:
                tree[idx] ^= val
                idx += idx & -idx
            # Subtract (XOR again) from position r + 1
            idx = r + 1
            while idx < tree_size:
                tree[idx] ^= val
                idx += idx & -idx
                
        def point_query(pos):
            res = 0
            idx = pos
            while idx > 0:
                res ^= tree[idx]
                idx -= idx & -idx
            return res

        # Track the active bitmask for each individual node's character
        cur_mask = [1 << (ord(c) - 97) for c in s]
        
        # Apply initial node values to their subtrees
        for i in range(n):
            range_update(tin[i], tout[i], cur_mask[i])
            
        ans = []
        for q in queries:
            parts = q.split()
            if parts[0] == "update":
                u = int(parts[1])
                c = parts[2]
                new_mask = 1 << (ord(c) - 97)
                diff = cur_mask[u] ^ new_mask
                if diff != 0:
                    range_update(tin[u], tout[u], diff)
                    cur_mask[u] = new_mask
            else:
                u = int(parts[1])
                v = int(parts[2])
                lca = get_lca(u, v)
                
                # Path XOR sum calculation
                path_mask = point_query(tin[u]) ^ point_query(tin[v]) ^ cur_mask[lca]
                # Check if at most one bit is set
                ans.append((path_mask & (path_mask - 1)) == 0)
                
        return ans
