** 2778. Sum of Squares of Special Elements **

# Approach 1:
class Solution:
    def sumOfSquares(self, nums: List[int]) -> int:
        n = len(nums)
        ans = 0

        for i in range(1, n + 1):
            if n % i == 0:
                ans += nums[i - 1] ** 2

        return ans

# Approach 2:
class Solution:
    def sumOfSquares(self, a: List[int]) -> int:
        return sum(v*v for i,v in enumerate(a,1) if len(a)%i==0)
