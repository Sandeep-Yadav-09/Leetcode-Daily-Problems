** 1254. Number of Closed Islands **

# Approach 1:
class Solution:
    def closedIsland(self, grid: List[List[int]]) -> int:
        rows, cols = len(grid), len(grid[0])

        def dfs(r, c):
            if r < 0 or r >= rows or c < 0 or c >= cols:
                return False

            if grid[r][c] == 1:
                return True

            grid[r][c] = 1

            up = dfs(r - 1, c)
            down = dfs(r + 1, c)
            left = dfs(r, c - 1)
            right = dfs(r, c + 1)

            return up and down and left and right

        count = 0

        for r in range(1, rows - 1):
            for c in range(1, cols - 1):
                if grid[r][c] == 0:
                    if dfs(r, c):
                        count += 1

        return count

# Approach 2:
from collections import deque

class Solution:
    def closedIsland(self, grid: list[list[int]]) -> int:

        m = len(grid)
        n= len(grid[0])

        visited = [[False]*n for i in range(m)]
        dir = [[0,1],[0,-1],[1,0],[-1,0]]
        ans = 0

        def bfs(row,col):

            queue = deque([[row,col]])
            visited[row][col]=True
            closed = True

            while queue:

                r,c = queue.popleft()
                if r==0 or c==0 or r==m-1 or c==n-1:
                    closed = False

                for dr,dc in dir:

                    nr,nc = r+dr, c+dc

                    if (0<=nr<m) and (0<=nc<n) and grid[nr][nc]==0 and not visited[nr][nc]:

                        visited[nr][nc]=True
                        queue.append([nr,nc])

            return closed

        for i in range(m):
            for j in range(n):

                if grid[i][j]==0 and not visited[i][j]:

                    if bfs(i,j):
                        ans+=1

        return ans
