** 3644. Maximum K to Sort a Permutation **

# Approach 1:
class Solution:
    def sortPermutation(self, nums: List[int]) -> int:
        return  ans  if (
            ans:= reduce(
                operator.and_,
                (n for i,n in enumerate(nums) if n!=i),
                initial=2**17-1
            )
        ) != 2**17-1  else 0

# Approach 2:
class Solution:
    def sortPermutation(self, nums: List[int]) -> int:
        ans = -1
        
        for i, num in enumerate(nums):
            if num != i:
                if ans == -1:
                    ans = num
                else:
                    ans &= num

        return 0 if ans == -1 else ans
