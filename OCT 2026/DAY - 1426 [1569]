** 1569. Number of Ways to Reorder Array to Get Same BST **

# Approach 1:
class Solution:
    def numOfWays(self, nums: list[int]) -> int:
        MOD = 10**9 + 7
        n = len(nums)

        idx = [0] * (n + 2)       
        for i, v in enumerate(nums):
            idx[v] = i

        L = list(range(-1, n + 1))       
        R = list(range(1, n + 3))       
        size = [1] * (n + 2)

        for i in range(n - 1, 0, -1):
            v = nums[i]
            p, s = L[v], R[v]
            if p >= 1 and (s > n or idx[p] > idx[s]):
                par = p
            else:
                par = s
            size[par] += size[v]
            R[p], L[s] = s, p           

        fact, prod = 1, 1
        for k in range(1, n + 1):
            fact = fact * k % MOD
            prod = prod * size[k] % MOD

        return (fact * pow(prod, MOD - 2, MOD) - 1) % MOD

# Approach 2:
import math

class Bst:
    def __init__(self, val):
        self.val = val
        self.left = None
        self.right = None
        self.size = 1

    def insert(self, val):
        if val < self.val:
            if self.left:
                self.left.insert(val)
            else:
                self.left = Bst(val)
        else:
            if self.right:
                self.right.insert(val)
            else:
                self.right = Bst(val)
        self.size += 1

class Solution:
    def numOfWays(self, nums: list[int]) -> int:
        mod = 10**9 + 7

        def helper(bst):
            if bst is None:
                return 1
            m = n = 0
            if bst.left:
                m = bst.left.size
            if bst.right:
                n = bst.right.size
            return (math.comb(m + n, n) * helper(bst.left) * helper(bst.right)) % mod

        root = Bst(nums[0])
        for num in nums[1:]:
            root.insert(num)

        return (helper(root) - 1) % mod
