** 2089. Find Target Indices After Sorting Array **

# Approach 1:
class Solution:
    def targetIndices(self, nums: list[int], target: int) -> list[int]:
        sor = sorted(nums)
        j = []

        for i in range(len(sor)):
            if sor[i] == target:
                j.append(i)

            if sor[i] > target:
                break

        return j

# Approach 2:
class Solution:
    def targetIndices(self, nums: list[int], target: int) -> list[int]:
        CountOflessThanTarget=0
        CountOfTarget=0
        for i in nums:
            if i<target:
                CountOflessThanTarget+=1
            if i==target:
                CountOfTarget+=1
        return [i for i in range(CountOflessThanTarget,CountOflessThanTarget+CountOfTarget,1)]
