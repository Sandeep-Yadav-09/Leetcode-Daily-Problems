** 3619. Count Islands With Total Value Divisible by K **

# Approach 1:
class Solution:
    def countIslands(self, grid: List[List[int]], k: int) -> int:
        m = len(grid)
        n = len(grid[0])

        directions = [(-1, 0), (1, 0), (0, -1), (0, 1)]

        res = 0
        for r in range(m):
            for c in range(n):
                if grid[r][c] == 0:
                    continue
                stack = [(r, c)]
                total = grid[r][c]
                grid[r][c] = 0
                while stack:
                    x, y = stack.pop()
                    for dx, dy in directions:
                        nx = x + dx
                        ny = y + dy
                        if (0 <= nx < m and 0 <= ny < n and grid[nx][ny] > 0):
                            total += grid[nx][ny]
                            grid[nx][ny] = 0
                            stack.append((nx, ny))
                if total % k == 0:
                    res += 1
                
        return res

# Approach 2:
class Solution:
    def countIslands(self, grid: List[List[int]], k: int) -> int:
        n = len(grid)
        m = len(grid[0])
        self.g = [[0]*m for _ in range(n)]
        def dfs(i,j):
            if i <0 or i==n or j<0 or j==m or grid[i][j]==0 or self.g[i][j] == 1:
                return 0
            self.g[i][j]=1    
            return grid[i][j]+dfs(i-1,j)+dfs(i+1,j)+dfs(i,j-1)+dfs(i,j+1)    
        ans = 0
        for i in range(n):
            for j in range(m):
                if grid[i][j]!=0 and self.g[i][j]!=1:
                    temp=dfs(i,j) 
                    ans+=1 if temp%k==0 else 0
        return ans               
