** 20. Valid Parentheses **

# Approach 1:
class Solution:
    def isValid(self, s: str) -> bool:
        stack = []
        mapping = {")":"(", "}":"{", "]":"["}

        for char in s:
            if char in mapping.values():
                stack.append(char)
            elif char in mapping.keys():
                if not stack or mapping[char] != stack.pop():
                    return False
        
        return not stack

# Approach 2:
class Solution:
    def isValid(self, s: str) -> bool:
        stk,mtch = [0], {")":"(", "]":"[", "}":"{"}
        for c in s:
            if   c in mtch.values():  stk.append(c)
            elif stk[-1] == mtch[c]:  stk.pop()
            else:                     return False
        return not stk.pop()
