** 1464. Maximum Product of Two Elements in an Array **

# Approach 1:
class Solution:
    def maxProduct(self, nums: List[int]) -> int:
        nums.sort(reverse= True)
        ans = (nums[0]-1)*(nums[1]-1)
        return ans

# Approach 2:
class Solution:
    def maxProduct(self, nums: List[int]) -> int:
        n1 = max(nums)
        nums.remove(n1)
        n2 = max(nums)
        return (n1-1)*(n2-1)
