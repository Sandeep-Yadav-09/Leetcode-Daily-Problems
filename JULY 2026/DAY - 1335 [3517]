** 3517. Smallest Palindromic Rearrangement I **

# Approach 1:
class Solution:
    def smallestPalindrome(self, s: str) -> str:
        freq = [0] * 26

        for c in s:
            freq[ord(c) - ord('a')] += 1

        n = len(s)
        ans = [''] * n

        left, right = 0, n - 1

        for i in range(26):
            while freq[i] >= 2:
                ans[left] = chr(ord('a') + i)
                ans[right] = chr(ord('a') + i)
                left += 1
                right -= 1
                freq[i] -= 2

            if freq[i] == 1:
                ans[n // 2] = chr(ord('a') + i)

        return ''.join(ans)

# Approach 2:
class Solution:
    def smallestPalindrome(self, s: str) -> str:
        size = len(s)
        firstHalf: str = s[0: size // 2]
        mid: str = ""
        if size % 2 == 1:
            mid = s[size // 2]
        return "".join(sorted(firstHalf)) + mid + "".join(sorted(firstHalf, reverse=True))
