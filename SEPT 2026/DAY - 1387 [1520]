** 1520. Maximum Number of Non-Overlapping Substrings **

# Approach 1:
class Solution:
    def maxNumOfSubstrings(self, s: str) -> list[str]:
        n = len(s)
        CHAR_SET_SZ = 26
        first_idx = [n] * CHAR_SET_SZ
        last_idx = [-1] * CHAR_SET_SZ
        
        # 1. Calculate the first and last occurrence indices for each character.
        for i, char in enumerate(s):
            idx = ord(char) - ord('a')
            if first_idx[idx] == n:
                first_idx[idx] = i
            last_idx[idx] = i
            
        valid_ranges = []
        
        # 2. Identify all valid isolated substring ranges for each present character.
        for i in range(CHAR_SET_SZ):
            start = first_idx[i]
            if start == n:  # Character not in string
                continue
                
            end = last_idx[i]
            is_valid = True
            
            j = start
            while j <= end:
                char_idx = ord(s[j]) - ord('a')
                # If an inner character starts before current character, range is invalid.
                if first_idx[char_idx] < start:
                    is_valid = False
                    break
                # Extend the end index to cover the inner character's last occurrence.
                end = max(end, last_idx[char_idx])
                j += 1
                
            if is_valid:
                valid_ranges.append((start, end))
                
        # 3. Sort the valid ranges: end ascending, then start descending.
        valid_ranges.sort(key=lambda x: (x[1], -x[0]))
        
        res = []
        last_included_end = -1
        
        # 4. Greedily select non-overlapping substrings based on the sorted order.
        for start, end in valid_ranges:
            if start > last_included_end:
                res.append(s[start:end + 1])
                last_included_end = end
                
        return res

# Approach 2:
class Solution:
    def maxNumOfSubstrings(self, s: str) -> List[str]:
        n = len(s)
        first = {}
        last = {}
        for i, c in enumerate(s):
            if c not in first:
                first[c] = i
            last[c] = i
        
        end = [-1] * n
        
        for i in range(n):
            c = s[i]
            if first[c] == i:
                e = last[c]
                k = i
                valid = True
                while k <= e:
                    if first[s[k]] < i:
                        valid = False
                        break
                    e = max(e, last[s[k]])
                    k += 1
                if valid:
                    end[i] = e
        
        dp = [(0, 0)] * (n + 1)
        take = [False] * n
        
        for i in range(n - 1, -1, -1):
            skip_count, skip_length = dp[i + 1]
            best_count, best_length = skip_count, skip_length
            best_take = False
            
            if end[i] != -1:
                e = end[i]
                t_count = dp[e + 1][0] + 1
                t_length = dp[e + 1][1] + (e - i + 1)
                if t_count > best_count or (t_count == best_count and t_length < best_length):
                    best_count, best_length = t_count, t_length
                    best_take = True
            
            dp[i] = (best_count, best_length)
            take[i] = best_take
        
        result = []
        i = 0
        while i < n:
            if take[i]:
                e = end[i]
                result.append(s[i:e+1])
                i = e + 1
            else:
                i += 1
        
        return result
