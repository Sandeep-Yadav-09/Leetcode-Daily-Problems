** 3870. Count Commas in Range **

# Approach 1:
class Solution:
    def countCommas(self, n: int) -> int:
        total_commas = 0
        base = 1000
        
        while n >= base:
            total_commas += (n - base + 1)
            base *= 1000
            
        return total_commas

# Approach 2:
class Solution:
    def countCommas(self, n: int) -> int:
        if n < 1000:
            return 0
        return n - 999
