** 3411. Maximum Subarray With Equal Products **

# Approach 1:
class Solution:
    def maxLength(self, nums: list[int]) -> int:
        def gcd(a: int, b: int) -> int:
            while b:
                a, b = b, a % b
            return a

        def lcm(a: int, b: int) -> int:
            return (a // gcd(a, b)) * b

        n = len(nums)
        max_len = 0
        for i in range(n):
            current_prod = 1
            current_gcd = nums[i]
            current_lcm = nums[i]
            for j in range(i, n):
                if current_prod > 1000000000000 // nums[j]:
                    current_prod = 2000000000000
                else:
                    current_prod *= nums[j]

                if j > i:
                    current_gcd = gcd(current_gcd, nums[j])
                    current_lcm = lcm(current_lcm, nums[j])

                if current_prod == current_lcm * current_gcd:
                    max_len = max(max_len, j - i + 1)
        return max_len

# Approach 2:
class Solution:
    def maxLength(self, nums: List[int]) -> int:
        n, ans = len(nums), 0

        for l in range(n):
            g = lc = nums[l]
            inv = 1.0 / nums[l]

            for r in range(l, n):
                if r > l:
                    g = gcd(g, nums[r])
                    lc = lcm(lc, nums[r])
                    inv /= nums[r]

                if g * lc * inv > 0.99999999:
                    ans = max(ans, r - l + 1)

        return ans
