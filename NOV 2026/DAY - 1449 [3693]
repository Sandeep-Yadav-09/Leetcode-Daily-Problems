** 3693. Climbing Stairs II **

# Approach 1:
class Solution:
    def climbStairs(self, n: int, costs: List[int]) -> int:
        a = b = c = 0
        for x in costs:
            a, b, c = b+5, c+3, x + (
                (a if a < c else c)
                   if a < b else
                (b if b < c else c)
            ) + 1
        return c

# Approach 2:
class Solution:
    def climbStairs(self, n: int, costs: List[int]) -> int:
        dp = [0] * (n + 1)

        for i in range(1, n + 1):
            dp[i] = float('inf')

            for jump in range(1, 4):
                prev = i - jump

                if prev >= 0:
                    cost = costs[i - 1] + jump * jump
                    dp[i] = min(dp[i], dp[prev] + cost)

        return dp[n]
