** 2911. Minimum Changes to Make K Semi-palindromes **

# Approach 1:
class Solution:
    def minimumChanges(self, s: str, k: int) -> int:
        n = len(s)
        cost = [[0] * n for _ in range(n)]

        for i in range(n):
            for j in range(i + 1, n):
                cost[i][j] = self.palin(s, i, j)

        dp = [1000000] * (n + 1)
        dp[0] = 0

        for j in range(1, k + 1):
            for i in range(n, 2 * j - 1, -1):
                best = 1000000
                for m in range(2 * (j - 1), i - 1):
                    val = dp[m] + cost[m][i - 1]
                    if val < best:
                        best = val
                dp[i] = best

        return dp[n]

    def palin(self, s: str, start: int, end: int) -> int:
        n = end - start + 1
        minc = 1000000
        for d in range(1, n // 2 + 1):
            if n % d != 0:
                continue
            c = 0
            g = n // d
            for i in range(d):
                if c >= minc:
                    break
                left = i + start
                right = start + i + (g - 1) * d
                while left < right:
                    if s[left] != s[right]:
                        c += 1
                    left += d
                    right -= d
            if c < minc:
                minc = c
        return minc

# Approach 2:
class Solution:
    def minimumChanges(self, s: str, k: int) -> int:
        n=len(s)
        divisors=[[] for _ in range(n+1)]
        for d in range(1,n):
            for length in range(2*d,n+1,d):
                divisors[length].append(d)


        @cache
        def peel(i:int,j:int,d:int)->int:
            if j-i <=d:
                return 0
            return sum(map(ne,s[i:i+d],s[j-d:j]))+peel(i+d,j-d,d)

        @cache
        def cost(i:int,j:int)->int:
            return min(peel(i,j,d) for d in divisors[j-i])

        best={0:0}

        for pieces in range(1,k):
            room=range(2*pieces,n-2*(k-pieces)+1)
            best={j:min(best[i]+cost(i,j) for i in best if i<=j-2) for j in room}

        return min(best[i]+cost(i,n) for i in best)
