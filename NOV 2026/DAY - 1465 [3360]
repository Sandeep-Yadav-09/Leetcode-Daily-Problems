** 3360. Stone Removal Game **

# Approach 1:
class Solution:
    def canAliceWin(self, n: int) -> bool:
        
        for stones in (19, 15, 11, 7, 3):

            if n >= stones: n-= stones
               
            else: return n >= stones//2 +1

        return True

# Approach 2:
class Solution:
    def canAliceWin(self, n: int) -> bool:
        stones = 10
        alice_turn = True
        while n >= stones:
            n -= stones
            stones -= 1
            alice_turn = not alice_turn
        return not alice_turn
