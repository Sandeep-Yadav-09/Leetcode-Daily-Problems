** 2243. Calculate Digit Sum of a String **

# Approach 1:
class Solution:
    def digitSum(self, s: str, k: int) -> str:
        while len(s)>k:
            ts = []
            for i in range(0,len(s),k):
                group = s[i:i+k]
                summ = sum(int(digit) for digit in group)
                ts.append(str(summ))
            s = "".join(ts)
        return s

# Approach 2:
class Solution:
    def digitSum(self, s: str, k: int) -> str:
        while len(s) > k:
            s = ''.join(str(sum(map(int, g))) for g in batched(s, k))
        return s
